{
  "name": "quotacheck-mcp",
  "version": "0.2.0",
  "description": "MCP server reporting current quota across Claude Code, Gemini web, Antigravity, and Codex",
  "type": "module",
  "bin": {
    "quotacheck-mcp": "dist/server.js",
    "quotacheck": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "login": "tsx src/cli.ts login",
    "report": "tsx scripts/report.ts",
    "daemon": "tsx src/cli.ts daemon",
    "quota": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "playwright": "^1.48.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "macos/App.swift",
    "macos/build.sh"
  ]
}
